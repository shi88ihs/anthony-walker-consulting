---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Badge from '../../components/shared/Badge.astro';
import Button from '../../components/shared/Button.astro';
import SectionHeader from '../../components/shared/SectionHeader.astro';

const title = 'Field IT Technician Perth WA | Anthony Walker';
const description = 'Field IT technician support across Perth for smart hands, hardware deployment, rack work, network troubleshooting, and site audits.';
const canonicalUrl = 'https://placeholder.com/services/field-it';

const includes = [
  'Hardware deployment and configuration',
  'Network equipment installation and troubleshooting',
  'Rack and stack work in server rooms and comms cupboards',
  'Smart hands support for remote teams',
  'Cable management and documentation',
  'On-site troubleshooting and infrastructure audits',
];

const background = [
  'MSP field experience',
  'Smart hands and remote-hands support',
  'Server room, comms cupboard, and workstation deployment experience',
  'Available for Perth on-site engagements and remote support',
];
---

<BaseLayout title={title} description={description} canonicalUrl={canonicalUrl}>
  <section class="border-b border-border bg-bg">
    <div class="mx-auto max-w-content px-4 py-12 sm:px-6 md:py-20 lg:px-8">
      <div class="max-w-4xl">
        <p class="font-mono text-sm font-bold uppercase text-amber">FIELD IT / SMART HANDS</p>
        <h1 class="mt-3 text-5xl font-black text-text md:text-6xl">On-Site Technical Support Across Perth.</h1>
        <p class="mt-6 max-w-3xl text-lg text-muted">
          Sometimes you need someone physically present. I provide reliable field technician services across Perth and surrounds.
        </p>
        <div class="mt-7 flex flex-wrap gap-2">
          {['--field-tech', '--perth', '--smart-hands', '--on-site'].map((flag) => <Badge label={flag} />)}
        </div>
        <div class="mt-9">
          <Button href="/contact">Book on-site support</Button>
        </div>
      </div>
    </div>
  </section>

  <section class="border-b border-border bg-surface/45">
    <div class="mx-auto max-w-content px-4 py-12 sm:px-6 md:py-20 lg:px-8">
      <SectionHeader
        eyebrow="WHAT THIS INCLUDES"
        heading="Physical work, documented properly."
        subtext="Useful when your remote team needs trusted hands on site, or your Perth office needs practical technical support."
      />

      <div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {includes.map((item) => (
          <div class="rounded-lg border border-border bg-surface p-5">
            <p class="text-sm font-medium text-text">{item}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-bg">
    <div class="mx-auto grid max-w-content gap-10 px-4 py-12 sm:px-6 md:py-20 lg:grid-cols-[0.9fr_1.1fr] lg:px-8">
      <aside class="rounded-lg border border-border bg-surface p-6">
        <p class="font-mono text-sm font-bold uppercase text-amber">RELEVANT IT BACKGROUND</p>
        <ul class="mt-6 space-y-4">
          {background.map((item) => (
            <li class="border-l-2 border-accent pl-4 text-sm text-muted">{item}</li>
          ))}
        </ul>
      </aside>

      <div>
        <SectionHeader
          eyebrow="ENGAGEMENTS"
          heading="Built for real site work."
          subtext="Field support is most useful when the scope is concrete: install this, trace that, document the cabinet, or act as remote hands for a technical team."
        />
        <div class="mt-8 flex flex-wrap gap-2">
          {['--hardware', '--networking', '--rack-and-stack', '--documentation'].map((flag) => <Badge label={flag} />)}
        </div>
        <div class="mt-9">
          <Button href="/contact">Book on-site support</Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
