---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Badge from '../../components/shared/Badge.astro';
import Button from '../../components/shared/Button.astro';
import SectionHeader from '../../components/shared/SectionHeader.astro';

const title = 'Linux Server & Cloud Admin Perth | Consulting Website';
const description = 'Linux server and cloud admin in Perth for AWS, Docker, VPS migration, monitoring, hardening, backups, and DevOps support.';
const canonicalUrl = 'https://placeholder.com/services/linux-cloud';

const sections = [
  {
    title: 'Linux Server Admin',
    body: 'Ubuntu and Debian setup, CentOS support, hardening with fail2ban, UFW and SSH keys, cron jobs, log management, and backup routines.',
    flags: ['--linux', '--security', '--bash'],
  },
  {
    title: 'AWS & Cloud',
    body: 'EC2, S3, Route53, IAM, cost review, migration planning, and small-to-mid-sized cloud infrastructure support.',
    flags: ['--aws', '--cloud', '--iam'],
  },
  {
    title: 'Docker & Containerisation',
    body: 'Docker Compose stacks, reverse proxies, Caddy configuration, health checks, and reproducible service deployment.',
    flags: ['--docker', '--compose', '--caddy'],
  },
  {
    title: 'VPS Migration',
    body: 'Moving services from one host to another with staged cutovers, rollback planning, DNS checks, and zero-downtime strategies where the stack allows it.',
    flags: ['--vps', '--migration', '--dns'],
  },
  {
    title: 'Monitoring & Alerting',
    body: 'Uptime monitoring setup, log aggregation basics, practical alerting, and simple runbooks for when something fails.',
    flags: ['--monitoring', '--logs', '--alerts'],
  },
];

const compatibility = [
  { category: 'Linux distributions', items: 'Ubuntu, Debian, CentOS' },
  { category: 'Cloud providers', items: 'AWS, VPS providers, bare-metal hosts' },
  { category: 'AWS services', items: 'EC2, S3, Route53, IAM, CloudWatch' },
  { category: 'Infrastructure tools', items: 'Docker, Docker Compose, Caddy, Nginx, Tailscale' },
];
---

<BaseLayout title={title} description={description} canonicalUrl={canonicalUrl}>
  <section class="border-b border-border bg-bg">
    <div class="mx-auto max-w-content px-4 py-12 sm:px-6 md:py-20 lg:px-8">
      <div class="max-w-4xl">
        <p class="font-mono text-sm font-bold uppercase text-amber">LINUX / CLOUD / DEVOPS</p>
        <h1 class="mt-3 text-5xl font-black text-text md:text-6xl">Reliable Infrastructure, Maintained Properly.</h1>
        <p class="mt-6 max-w-3xl text-lg text-muted">
          Linux administration, cloud deployment, and DevOps support for businesses that can't afford downtime or guesswork.
        </p>
        <div class="mt-7 flex flex-wrap gap-2">
          {['--linux', '--aws', '--docker', '--vps', '--monitoring'].map((flag) => <Badge label={flag} />)}
        </div>
        <div class="mt-9">
          <Button href="/contact">Get a quote</Button>
        </div>
      </div>
    </div>
  </section>

  <section class="border-b border-border bg-surface/45">
    <div class="mx-auto max-w-content px-4 py-12 sm:px-6 md:py-20 lg:px-8">
      <SectionHeader
        eyebrow="SUPPORT AREAS"
        heading="Infrastructure work with clear ownership."
        subtext="From hardening a single VPS to moving a service stack into a cleaner deployment model."
      />

      <div class="mt-10 grid gap-5 md:grid-cols-2">
        {sections.map((section) => (
          <article class="rounded-lg border border-border bg-surface p-6">
            <h2 class="text-xl font-black text-text">{section.title}</h2>
            <p class="mt-3 text-sm text-muted">{section.body}</p>
            <div class="mt-5 flex flex-wrap gap-2">
              {section.flags.map((flag) => <Badge label={flag} />)}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-bg">
    <div class="mx-auto max-w-content px-4 py-12 sm:px-6 md:py-20 lg:px-8">
      <SectionHeader
        eyebrow="COMPATIBILITY"
        heading="Systems I have worked with."
        subtext="A practical compatibility snapshot for common Linux, cloud, and hosting environments."
      />

      <div class="mt-10 overflow-hidden rounded-lg border border-border bg-surface">
        <table class="w-full border-collapse text-left text-sm">
          <thead class="bg-bg/80 text-text">
            <tr>
              <th scope="col" class="border-b border-border px-5 py-4 font-bold">Area</th>
              <th scope="col" class="border-b border-border px-5 py-4 font-bold">Experience</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border">
            {compatibility.map((row) => (
              <tr>
                <th scope="row" class="px-5 py-4 font-mono text-xs font-bold uppercase text-amber">{row.category}</th>
                <td class="px-5 py-4 text-muted">{row.items}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="mt-10">
        <Button href="/contact">Get a quote</Button>
      </div>
    </div>
  </section>
</BaseLayout>
