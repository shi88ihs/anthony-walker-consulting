---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Badge from '../../components/shared/Badge.astro';
import SectionHeader from '../../components/shared/SectionHeader.astro';

const title = 'IT Consulting Case Studies | Consulting Website';
const description = 'Anonymised Perth IT consulting case studies covering AI automation, Linux cloud work, Docker VPS migrations, and field IT support.';
const canonicalUrl = 'https://placeholder.com/case-studies';

const categories = ['AI & Automation', 'Linux & Cloud', 'Docker & VPS', 'Field IT'] as const;
const categoryAnchors: Record<(typeof categories)[number], string> = {
  'AI & Automation': 'ai-automation',
  'Linux & Cloud': 'linux-cloud',
  'Docker & VPS': 'docker-vps',
  'Field IT': 'field-it',
};

const caseStudies = (await getCollection('case-studies', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.localeCompare(a.data.date) || a.data.title.localeCompare(b.data.title));

const studiesByCategory = categories
  .map((category) => ({
    category,
    anchor: categoryAnchors[category],
    entries: caseStudies.filter((entry) => entry.data.category === category),
  }))
  .filter((group) => group.entries.length > 0);

const formatDate = (date: string) => new Intl.DateTimeFormat('en-AU', {
  month: 'long',
  year: 'numeric',
}).format(new Date(`${date}-01T00:00:00Z`));
---

<BaseLayout title={title} description={description} canonicalUrl={canonicalUrl}>
  <section id="all" class="border-b border-border bg-bg">
    <div class="mx-auto max-w-content px-4 py-12 sm:px-6 md:py-20 lg:px-8">
      <div class="max-w-4xl">
        <p class="font-mono text-sm font-bold uppercase text-amber">CASE STUDIES</p>
        <h1 class="mt-3 text-5xl font-black text-text md:text-6xl">Real infrastructure work, anonymised.</h1>
        <p class="mt-6 max-w-3xl text-lg text-muted">
          Practical examples of AI automation, Linux cloud support, Docker VPS migration, and field IT work. Client names and sensitive details are withheld.
        </p>
      </div>

      <nav class="mt-8 flex flex-wrap gap-2" aria-label="Case study categories">
        <a href="#all" class="inline-flex rounded-lg border border-border bg-surface px-3 py-2 font-mono text-xs font-bold text-amber hover:text-text">
          # all
        </a>
        {studiesByCategory.map((group) => (
          <a href={`#${group.anchor}`} class="inline-flex rounded-lg border border-border bg-surface px-3 py-2 font-mono text-xs font-bold text-muted hover:text-accent">
            # {group.category}
          </a>
        ))}
      </nav>
    </div>
  </section>

  <section class="bg-surface/45">
    <div class="mx-auto max-w-content px-4 py-12 sm:px-6 md:py-20 lg:px-8">
      <SectionHeader
        eyebrow="RECENT WORK"
        heading="Browse by service area."
        subtext="Each case study is written without client names, private hostnames, revenue figures, or invented metrics."
      />

      <div class="mt-10 space-y-12">
        {studiesByCategory.map((group) => (
          <section id={group.anchor} class="scroll-mt-28">
            <div class="mb-5 flex flex-wrap items-end justify-between gap-3">
              <div>
                <Badge label={group.category} tone="accent" />
                <h2 class="mt-3 text-3xl font-black text-text">{group.category}</h2>
              </div>
              <a href="#all" class="text-sm font-bold text-muted hover:text-accent">Back to filters</a>
            </div>

            <div class="grid gap-5 md:grid-cols-2">
              {group.entries.map((entry) => (
                <article class="flex h-full flex-col rounded-lg border border-border bg-surface p-6">
                  <div class="flex flex-wrap items-center gap-3">
                    <Badge label={entry.data.category} tone="accent" />
                    <span class="font-mono text-xs font-bold uppercase text-muted">{formatDate(entry.data.date)}</span>
                  </div>
                  <h3 class="mt-5 text-2xl font-black text-text">{entry.data.title}</h3>
                  <p class="mt-3 flex-1 text-sm text-muted">{entry.data.summary}</p>
                  <div class="mt-6 flex flex-wrap gap-2">
                    {entry.data.tags.map((tag) => <Badge label={tag} />)}
                  </div>
                  <a href={`/case-studies/${entry.slug}`} class="mt-8 inline-flex items-center gap-2 text-sm font-bold text-accent hover:text-text">
                    Read case study
                    <span aria-hidden="true">-&gt;</span>
                  </a>
                </article>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
