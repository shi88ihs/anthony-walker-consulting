---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseStudyLayout from '../../layouts/CaseStudyLayout.astro';

type CaseStudyEntry = CollectionEntry<'case-studies'>;

interface Props {
  entry: CaseStudyEntry;
}

export async function getStaticPaths() {
  const caseStudies = await getCollection('case-studies', ({ data }) => !data.draft);

  return caseStudies.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const canonicalUrl = `https://placeholder.com/case-studies/${entry.slug}`;
const seoTitles: Record<string, string> = {
  'ai-agent-infrastructure': 'AI Agent Workflow Case Study | Consulting Website',
  'aws-automation': 'AWS Automation Case Study | Consulting Website',
  'docker-reverse-proxy': 'Docker Caddy Migration Case Study | Consulting Website',
  'field-technician-support': 'Perth Field IT Case Study | Consulting Website',
  'linux-hardening': 'Linux Hardening Case Study | Consulting Website',
  'vaultwarden-migration': 'Vaultwarden VPS Case Study | Consulting Website',
};
const seoTitle = seoTitles[entry.slug] ?? `${entry.data.title} | Consulting Website`;
---

<BaseLayout
  title={seoTitle}
  description={entry.data.summary}
  canonicalUrl={canonicalUrl}
>
  <CaseStudyLayout
    title={entry.data.title}
    summary={entry.data.summary}
    category={entry.data.category}
    tags={entry.data.tags}
    challenge={entry.data.challenge}
    outcome={entry.data.outcome}
    date={entry.data.date}
  >
    <Content />
  </CaseStudyLayout>
</BaseLayout>
