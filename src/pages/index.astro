---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import ValueProp from '../components/home/ValueProp.astro';
import ServiceCards from '../components/home/ServiceCards.astro';
import WhoIHelp from '../components/home/WhoIHelp.astro';
import CaseStudyPreview from '../components/home/CaseStudyPreview.astro';
import CtaBanner from '../components/home/CtaBanner.astro';

const title = 'IT Consultant Perth WA | Anthony Walker';
const description = 'Independent Perth IT consultant for Linux, cloud infrastructure, AI agent deployment, Docker, and field technician support.';
const canonicalUrl = 'https://placeholder.com/';
---

<BaseLayout title={title} description={description} canonicalUrl={canonicalUrl}>
  <Hero />
  <ValueProp />
  <ServiceCards />
  <WhoIHelp />
  <CaseStudyPreview />
  <CtaBanner />
</BaseLayout>
