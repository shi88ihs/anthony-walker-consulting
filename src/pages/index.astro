---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'IT Consultant Perth WA';
const description = 'Independent Perth IT consultant for Linux, cloud infrastructure, AI agent deployment, Docker, and field technician support.';
const canonicalUrl = 'https://placeholder.com/';
---

<BaseLayout title={title} description={description} canonicalUrl={canonicalUrl}>
  <section class="mx-auto max-w-content px-4 py-20 sm:px-6 lg:px-8">
    <p class="font-mono text-sm font-medium text-amber"># --phase-1 --layout-shell</p>
    <h1 class="mt-5 max-w-3xl text-5xl font-black text-text md:text-6xl">
      Anthony Walker IT Consulting
    </h1>
  </section>
</BaseLayout>
