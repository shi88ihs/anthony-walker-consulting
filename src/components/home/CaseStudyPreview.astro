---
import { getCollection } from 'astro:content';
import Badge from '../shared/Badge.astro';
import SectionHeader from '../shared/SectionHeader.astro';

const previewOrder = [
  'ai-agent-infrastructure',
  'aws-automation',
  'field-technician-support',
];

const caseStudies = await getCollection('case-studies', ({ data }) => !data.draft);
const previews = previewOrder
  .map((slug) => caseStudies.find((entry) => entry.slug === slug))
  .filter((entry): entry is (typeof caseStudies)[number] => Boolean(entry))
  .slice(0, 3);
---

<section class="border-b border-border bg-surface/45">
  <div class="mx-auto max-w-content px-4 py-12 sm:px-6 md:py-20 lg:px-8">
    <SectionHeader
      eyebrow="RECENT WORK"
      heading="How I've helped."
    />

    <div class="mt-10 grid gap-5 md:grid-cols-3">
      {previews.map((preview) => (
        <article class="flex h-full flex-col rounded-lg border border-border bg-surface p-6">
          <Badge label={preview.data.category} tone="accent" class="self-start" />
          <h3 class="mt-5 text-xl font-black text-text">{preview.data.title}</h3>
          <p class="mt-3 flex-1 text-sm text-muted">{preview.data.summary}</p>
          <a href={`/case-studies/${preview.slug}`} class="mt-6 inline-flex items-center gap-2 text-sm font-bold text-accent hover:text-text">
            Read case study
            <span aria-hidden="true">-&gt;</span>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
