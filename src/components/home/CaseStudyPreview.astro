---
import Badge from '../shared/Badge.astro';
import SectionHeader from '../shared/SectionHeader.astro';

const previews = [
  {
    category: '--ai-automation',
    title: '[PLACEHOLDER] AI and automation case study',
    summary: '[PLACEHOLDER] One-sentence case study summary will appear here.',
  },
  {
    category: '--linux-cloud',
    title: '[PLACEHOLDER] Linux and cloud case study',
    summary: '[PLACEHOLDER] One-sentence case study summary will appear here.',
  },
  {
    category: '--field-it',
    title: '[PLACEHOLDER] Field IT case study',
    summary: '[PLACEHOLDER] One-sentence case study summary will appear here.',
  },
];
---

<section class="border-b border-border bg-surface/45">
  <div class="mx-auto max-w-content px-4 py-12 sm:px-6 md:py-20 lg:px-8">
    <SectionHeader
      eyebrow="RECENT WORK"
      heading="How I've helped."
    />

    <div class="mt-10 grid gap-5 md:grid-cols-3">
      {previews.map((preview) => (
        <article class="flex h-full flex-col rounded-lg border border-border bg-surface p-6">
          <Badge label={preview.category} tone="accent" class="self-start" />
          <h3 class="mt-5 text-xl font-black text-text">{preview.title}</h3>
          <p class="mt-3 flex-1 text-sm text-muted">{preview.summary}</p>
          <a href="/case-studies" class="mt-6 inline-flex items-center gap-2 text-sm font-bold text-accent hover:text-text">
            Read case study
            <span aria-hidden="true">-&gt;</span>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
