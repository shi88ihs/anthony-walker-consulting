---
import Button from '../shared/Button.astro';
---

<section class="bg-bg">
  <div class="mx-auto max-w-content px-4 py-12 sm:px-6 md:py-20 lg:px-8">
    <div class="rounded-lg border border-border bg-surface px-6 py-10 text-center md:px-10 md:py-14">
      <h2 class="text-3xl font-black text-text md:text-4xl">Ready to move forward?</h2>
      <p class="mx-auto mt-4 max-w-2xl text-base text-muted md:text-lg">
        No lengthy discovery process. Tell me what you need and I'll tell you if and how I can help.
      </p>
      <div class="mt-8">
        <Button href="/contact">Get in Touch</Button>
      </div>
    </div>
  </div>
</section>
