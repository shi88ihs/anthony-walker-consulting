---
import Badge from '../components/shared/Badge.astro';
import Button from '../components/shared/Button.astro';

interface Props {
  title: string;
  summary: string;
  category: 'AI & Automation' | 'Linux & Cloud' | 'Field IT' | 'Docker & VPS';
  tags: string[];
  challenge: string;
  outcome: string;
  date: string;
}

const {
  title,
  summary,
  category,
  tags,
  challenge,
  outcome,
  date,
} = Astro.props;

const publishedDate = new Intl.DateTimeFormat('en-AU', {
  month: 'long',
  year: 'numeric',
}).format(new Date(`${date}-01T00:00:00Z`));
---

<section class="border-b border-border bg-bg">
  <div class="mx-auto max-w-content px-4 py-12 sm:px-6 md:py-20 lg:px-8">
    <div class="max-w-4xl">
      <div class="flex flex-wrap items-center gap-3">
        <Badge label={category} tone="accent" />
        <span class="font-mono text-xs font-bold uppercase text-muted">{publishedDate}</span>
      </div>
      <h1 class="mt-5 text-4xl font-black text-text md:text-6xl">{title}</h1>
      <p class="mt-6 max-w-3xl text-lg text-muted">{summary}</p>
      <div class="mt-7 flex flex-wrap gap-2">
        {tags.map((tag) => <Badge label={tag} />)}
      </div>
    </div>
  </div>
</section>

<section class="border-b border-border bg-surface/45">
  <div class="mx-auto grid max-w-content gap-8 px-4 py-12 sm:px-6 md:py-20 lg:grid-cols-[minmax(0,1fr)_22rem] lg:px-8">
    <article class="case-study-prose rounded-lg border border-border bg-bg p-6 md:p-8">
      <slot />
    </article>

    <aside class="space-y-5 lg:sticky lg:top-28 lg:self-start">
      <div class="rounded-lg border border-border bg-surface p-6">
        <p class="font-mono text-xs font-bold uppercase text-amber">CASE STUDY</p>
        <dl class="mt-5 space-y-5">
          <div>
            <dt class="text-xs font-bold uppercase tracking-normal text-muted">Category</dt>
            <dd class="mt-2 text-sm font-bold text-text">{category}</dd>
          </div>
          <div>
            <dt class="text-xs font-bold uppercase tracking-normal text-muted">Published</dt>
            <dd class="mt-2 text-sm font-bold text-text">{publishedDate}</dd>
          </div>
          <div>
            <dt class="text-xs font-bold uppercase tracking-normal text-muted">Tags</dt>
            <dd class="mt-3 flex flex-wrap gap-2">
              {tags.map((tag) => <Badge label={tag} />)}
            </dd>
          </div>
        </dl>
      </div>

      <div class="rounded-lg border border-border bg-surface p-6">
        <p class="font-mono text-xs font-bold uppercase text-amber">CHALLENGE</p>
        <p class="mt-3 text-sm text-muted">{challenge}</p>
      </div>

      <div class="rounded-lg border border-border bg-surface p-6">
        <p class="font-mono text-xs font-bold uppercase text-success">OUTCOME</p>
        <p class="mt-3 text-sm text-muted">{outcome}</p>
      </div>
    </aside>
  </div>
</section>

<section class="bg-bg">
  <div class="mx-auto max-w-content px-4 py-12 sm:px-6 md:py-20 lg:px-8">
    <div class="rounded-lg border border-border bg-surface px-6 py-10 md:px-10 md:py-12">
      <div class="grid gap-8 md:grid-cols-[1fr_auto] md:items-center">
        <div>
          <p class="font-mono text-sm font-bold uppercase text-amber">NEXT STEP</p>
          <h2 class="mt-3 text-3xl font-black text-text md:text-4xl">Work with me on something similar.</h2>
          <p class="mt-4 max-w-2xl text-base text-muted md:text-lg">
            Send through the infrastructure, automation, or field support problem you need handled.
          </p>
        </div>
        <div class="md:justify-self-end">
          <Button href="/contact">Get in Touch</Button>
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .case-study-prose {
    color: var(--color-muted);
  }

  .case-study-prose h2 {
    margin-top: 2rem;
    color: var(--color-text);
    font-size: 1.5rem;
    font-weight: 900;
    line-height: 2rem;
  }

  .case-study-prose h2:first-child {
    margin-top: 0;
  }

  .case-study-prose p {
    margin-top: 1rem;
  }

  .case-study-prose code {
    border-radius: 0.375rem;
    background: var(--color-surface);
    color: var(--color-amber);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.875em;
    padding: 0.125rem 0.25rem;
  }
</style>
